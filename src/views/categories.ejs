<%- include('partials/header', { title: title || 'Categories', description: description || '' }) %>

<main>
    <h1>Project Categories</h1>
    <p><%= description %></p>

    <% if (typeof error !== 'undefined' && error) { %>
        <div style="padding:1rem;background:#fee;border:1px solid #f99;border-radius:6px;color:#933;margin:1rem 0;">
            <strong>⚠️ Database Error:</strong> <%= error %>
        </div>
    <% } %>

    <% const cats = (typeof categories !== 'undefined' && Array.isArray(categories)) ? categories : []; %>

    <% if (cats.length === 0) { %>
        <p style="color:#666;"><em>No categories available.</em></p>
    <% } else { %>
        <ul class="categories-list">
            <% cats.forEach(cat => { %>
                <li>
                    <a href="/category/<%= cat.category_id %>"><%= cat.name %></a>
                </li>
            <% }); %>
        </ul>
    <% } %>
</main>


<% if (user && user.role_name === 'admin') { %>
   <p><a href="/new-category">Add a New Category</a></p>
<% } %>

<%- include('partials/footer') %>