<%- include('partials/header', { title: title || 'Category Details', description: description || '' }) %>

<main>
    <h1>Category: <%= category.name %></h1>
    <% if (user && user.role_name === 'admin') { %>
   <p><a href="/edit-category/<%= category.category_id %>">Edit Category</a></p>
<% } %>

    <p><%= description %></p>

    <% if (typeof error !== 'undefined' && error) { %>
        <div style="padding:1rem;background:#fee;border:1px solid #f99;border-radius:6px;color:#933;margin:1rem 0;">
            <strong>⚠️ Database Error:</strong> <%= error %>
        </div>
    <% } %>

    <% const projs = (typeof projects !== 'undefined' && Array.isArray(projects)) ? projects : []; %>

    <% if (projs.length === 0) { %>
        <p style="color:#666;"><em>No service projects in this category.</em></p>
    <% } else { %>
        <ul>
            <% projs.forEach(proj => { %>
                <li>
                    <a href="/project/<%= proj.project_id %>"><%= proj.title %></a>
                    (<%= proj.organization_name %>)
                </li>
            <% }); %>
        </ul>
    <% } %>

    <p><a href="/categories">← Back to all categories</a></p>
</main>

<%- include('partials/footer') %>