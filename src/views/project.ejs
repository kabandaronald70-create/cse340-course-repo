<%- include('partials/header', { title: title || 'Project Details', description: description || '' }) %>

<main>
    <h1><%= project.title %></h1>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <% } %>

    <p><strong>Description:</strong> <%= project.description %></p>
    <p><strong>Date:</strong> 
        <%= new Date(project.project_date).toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'long', 
            day: 'numeric' 
        }) %>
    </p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Organization:</strong> 
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <%# Category tags section %>
    <% if (categories && categories.length > 0) { %>
        <p><strong>Categories:</strong>
            <% categories.forEach((cat, index) => { %>
                <a href="/category/<%= cat.category_id %>"><%= cat.name %></a><% if (index < categories.length - 1) { %>, <% } %>
            <% }); %>
        </p>
    <% } %>

    <%# Volunteer section — only for logged-in users %>
    <% if (user) { %>
        <hr>
        <% if (volunteering) { %>
            <p><strong>✅ You are volunteering for this project.</strong></p>
            <form method="POST" action="/unvolunteer/<%= project.project_id %>" style="display:inline;">
                <button type="submit">Remove me as a volunteer</button>
            </form>
        <% } else { %>
            <form method="POST" action="/volunteer/<%= project.project_id %>" style="display:inline;">
                <button type="submit">Volunteer for this project</button>
            </form>
        <% } %>
        <hr>
    <% } %>

    <p><a href="/projects">← Back to upcoming projects</a></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>